# AWS Infrastructure & Deployment Configuration Template
# (Copy to .env for local overrides; NEVER commit production secrets)

# AWS Account and Region
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=663252309163

# Amazon Cognito Configuration
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Amazon API Gateway Endpoint (Canonical Frontend Setting: VITE_API_BASE_URL)
VITE_API_BASE_URL=https://XXXXXXXXXX.execute-api.ap-south-1.amazonaws.com/prod

# Amazon DynamoDB Table Names
USERS_TABLE=AQ_UsersAndPlans
SCHOOL_TABLE=AQ_SchoolPlanner
MARKETPLACE_TABLE=AQ_Marketplace
AIR_TABLE=AQ_AirObservations

# Amazon S3 Asset Storage
ASSETS_BUCKET=air-quality-intelligence-assets-placeholder

# Amazon Bedrock AI Configuration
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Pre-seeded Demonstration Account Provisioning Passwords (Controlled locally, never committed)
# DEMO_USERS_PASSWORD=
