{
  "name": "air-quality-intelligence-infra",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "app": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.js",
    "synth": "cdk synth",
    "synth:prod": "cdk synth -c env=prod",
    "synth:sandbox": "cdk synth -c env=sandbox"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.170.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.3.0"
  }
}
